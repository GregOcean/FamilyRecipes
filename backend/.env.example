# Copy to .env, fill values, then export with: set -a; source .env; set +a
DB_URL='jdbc:mysql://127.0.0.1:3306/family_recipes?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC'
DB_USERNAME=familyrecipes
DB_PASSWORD=
# Generate with openssl rand -hex 32. At least 32 bytes, no default secret.
JWT_SECRET=
MEDIA_DIR=/var/lib/familyrecipes/media
PUBLIC_BASE_URL=https://api.familyrecipes.live

# Local Mailpit; replace these to deliver real email via your SMTP provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM=noreply@familyrecipes.test
SMTP_USERNAME=
SMTP_PASSWORD=
