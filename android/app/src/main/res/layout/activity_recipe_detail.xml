<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ThemeOverlay.FamilyRecipes.Toolbar"        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/toolbar_background"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/ui_fbb7e7ea47"
        app:titleTextColor="@color/on_toolbar">
        
        <!-- 编辑按钮 -->
        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:text="@string/ui_95b351c862"
            android:textColor="@color/on_toolbar"
            android:textSize="16sp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
            
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout android:id="@+id/detail_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingHorizontal="16dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/tv_detail_error" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_retry"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/review_retry" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 必须只有一个直接子元素，所以用 FrameLayout 包装 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="100dp"
                android:visibility="visible" />

            <!-- Content Layout -->
            <LinearLayout
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Cover Image -->
            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/ui_b3c87b5389"
                tools:src="@drawable/placeholder_recipe" />

            <!-- Recipe Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Recipe Name -->
                    <TextView
                        android:id="@+id/tv_name"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="宫保鸡丁" />

                    <!-- Creator -->
                    <TextView
                        android:id="@+id/tv_creator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="创建者：家肴用户_DEV" />

                    <TextView android:id="@+id/tv_cooking_time"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                    <!-- Additional Info Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_difficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:drawablePadding="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_difficulty"
                            tools:text="难度：适中" />

                        <TextView
                            android:id="@+id/tv_servings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_servings"
                            tools:text="2-3人份" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/description_heading"
                        android:text="@string/review_recipe_about"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        tools:text="这是一道经典的川菜，鸡肉鲜嫩，花生酥脆，酸甜微辣，非常下饭。" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_expand_description" style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/review_expand_description" android:visibility="gone" />
                <LinearLayout android:id="@+id/gallery" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- External Links Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_external_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_b2cea874e0"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_external_links"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                    <!-- Tags -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp"
                        app:chipSpacing="4dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/tv_view_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginEnd="16dp" />
                <TextView android:id="@+id/tv_favorite_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <!-- Comments Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_comments_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/comments_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_comments_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_comments_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/comments_input_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">
                        <EditText
                            android:id="@+id/et_comment_input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="@string/recipe_comment_hint"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:background="@drawable/search_background"
                            android:paddingHorizontal="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_comment"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/recipe_comment_send"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Equal actions, compact spacing, accessible 48dp targets. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="12dp" android:paddingVertical="0dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_favorite"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:minWidth="0dp" android:paddingHorizontal="4dp" android:insetTop="6dp" android:insetBottom="6dp"
            android:text="@string/ui_ae336cd047" android:textSize="14sp"
            app:icon="@drawable/ic_favorite_border" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_dislike"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:layout_marginHorizontal="6dp" android:minWidth="0dp" android:paddingHorizontal="4dp"
            android:insetTop="6dp" android:insetBottom="6dp" android:text="@string/dislike_short" android:textSize="14sp"
            app:icon="@drawable/ic_thumb_down_outline" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:minWidth="0dp" android:paddingHorizontal="4dp" android:insetTop="6dp" android:insetBottom="6dp"
            android:text="@string/recipe_more_short" android:textSize="14sp"
            android:contentDescription="@string/recipe_more_actions" app:icon="@drawable/ic_more_vert" app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
