<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FamilyRecipesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyRecipes"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <!-- 启动欢迎页 -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyRecipes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 主Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes"
            android:windowSoftInputMode="stateHidden|adjustPan">
        </activity>
        
        <!-- 拍照Activity -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 菜谱详情Activity -->
        <activity
            android:name=".ui.recipe.RecipeDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 添加/编辑菜谱Activity -->
        <activity
            android:name=".ui.recipe.EditRecipeActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 我的收藏Activity -->
        <activity
            android:name=".ui.profile.FavoriteRecipesActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 我上传的菜谱Activity -->
        <activity
            android:name=".ui.profile.MyCreatedRecipesActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 添加食材Activity -->
        <activity
            android:name=".ui.fridge.AddIngredientActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        
        <!-- 搜索结果Activity -->
        <activity
            android:name=".ui.search.SearchResultActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyRecipes"
            android:windowSoftInputMode="stateHidden|adjustPan" />
        
        <!-- FileProvider for camera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <!-- WorkManager - 食材过期提醒 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>
        
        <!-- 社交功能相关Activity -->
        <activity
            android:name=".ui.social.MyQRCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".ui.social.ScanQRActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
        
        <activity
            android:name=".ui.social.FriendsListActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.social.GroupsListActivity"
            android:exported="false" />
        
        <!-- 我加入的群 -->
        <activity
            android:name=".ui.social.JoinedGroupsActivity"
            android:exported="false" />
        
        <!-- 我创建的群 -->
        <activity
            android:name=".ui.social.CreatedGroupsActivity"
            android:exported="false" />
        
        <!-- 创建群聊 -->
        <activity
            android:name=".ui.social.CreateGroupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FamilyRecipes" />
        
        <!-- 群聊天 -->
        <activity
            android:name=".ui.social.GroupChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FamilyRecipes" />
        
    </application>

</manifest>

